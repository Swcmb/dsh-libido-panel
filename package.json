{
  "name": "dsh-libido-panel",
  "version": "1.0.0",
  "description": "A standard DSH bundle with a local state panel and a conversation composer HUD.",
  "type": "module",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Swcmb/dsh-libido-panel.git"
  },
  "homepage": "https://github.com/Swcmb/dsh-libido-panel#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "bundle",
    "composer-hud"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node panel/server.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./plugin/client.js",
    "./locale/*.json": "./plugin/locale/*.json",
    "./icon": "./plugin/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "plugin/index.js",
    "plugin/client.js",
    "plugin/icon.svg",
    "plugin/locale/*.json",
    "docs/**",
    "panel/**",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
